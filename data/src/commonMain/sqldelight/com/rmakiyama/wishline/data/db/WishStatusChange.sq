CREATE TABLE wish_status_change (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    wish_id TEXT NOT NULL,
    status TEXT NOT NULL,
    bingo_card_id TEXT,
    changed_at INTEGER NOT NULL
);

CREATE INDEX wish_status_change_wish ON wish_status_change(wish_id);

insert:
INSERT INTO wish_status_change (wish_id, status, bingo_card_id, changed_at) VALUES (?, ?, ?, ?);

selectByWish:
SELECT * FROM wish_status_change WHERE wish_id = ? ORDER BY changed_at ASC, id ASC;

deleteByWish:
DELETE FROM wish_status_change WHERE wish_id = ?;
