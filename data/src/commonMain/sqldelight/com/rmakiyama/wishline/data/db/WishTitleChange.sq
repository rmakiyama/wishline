CREATE TABLE wish_title_change (
    id TEXT NOT NULL PRIMARY KEY,
    wish_id TEXT NOT NULL REFERENCES wish(id) ON DELETE RESTRICT,
    title TEXT NOT NULL,
    changed_at INTEGER NOT NULL
);

CREATE INDEX wish_title_change_wish ON wish_title_change(wish_id);

insert:
INSERT INTO wish_title_change (id, wish_id, title, changed_at) VALUES (?, ?, ?, ?);

selectByWish:
SELECT * FROM wish_title_change WHERE wish_id = ? ORDER BY changed_at ASC, rowid ASC;

deleteByWish:
DELETE FROM wish_title_change WHERE wish_id = ?;
