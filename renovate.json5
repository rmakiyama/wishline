{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePresets": [
    ":prHourlyLimit2",
    ":prConcurrentLimit10"
  ],
  "timezone": "Asia/Tokyo",
  "labels": [
    "renovate",
  ],
  "major": {
    "minimumReleaseAge": "14 days",
  },
  "minor": {
    "minimumReleaseAge": "7 days",
  },
  "patch": {
    "minimumReleaseAge": "7 days",
    "automerge": true,
  },
  "branchConcurrentLimit": 3,
}
